  <circle cx="955" cy="205" r="120" fill="#67e8f9" opacity="0.16"/>
  <circle cx="980" cy="240" r="72" fill="#e5eefb" opacity="0.12"/>
  <rect x="145" y="150" width="420" height="26" rx="13" fill="#e5eefb" opacity="0.65"/>
